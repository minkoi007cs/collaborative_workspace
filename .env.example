# Local development only; replace values for shared or production environments.
DATABASE_URL=postgresql://syncspace:syncspace@localhost:55432/syncspace?schema=public
REDIS_URL=redis://localhost:56379
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Phase 2: set these from your Supabase project. Use an asymmetric JWT signing key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server only. Keep this secret out of NEXT_PUBLIC_* variables and Git.
SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket as private with a 10 MB limit and the MIME allowlist in the README.
STORAGE_BUCKET=syncspace-attachments
