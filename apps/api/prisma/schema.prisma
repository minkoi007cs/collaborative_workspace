generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1 connectivity probe. Remove with a reviewed migration once a domain health query replaces it.
model InfrastructureProbe {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("infrastructure_probe")
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  authSubject           String                @unique @map("auth_subject") @db.Uuid
  email                 String                @db.VarChar(320)
  displayName           String                @map("display_name") @db.VarChar(80)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  ownedWorkspaces       Workspace[]           @relation("WorkspaceOwner")
  memberships           WorkspaceMember[]
  sentInvitations       WorkspaceInvitation[] @relation("InvitationSender")
  createdProjects       Project[]             @relation("ProjectCreator")
  createdTasks          Task[]                @relation("TaskCreator")
  taskAssignments       TaskAssignee[]
  comments              Comment[]             @relation("CommentAuthor")
  commentMentions       CommentMention[]
  receivedNotifications Notification[]        @relation("NotificationRecipient")
  sentNotifications     Notification[]        @relation("NotificationActor")
  activityEvents        ActivityEvent[]
  uploadedAttachments   Attachment[]          @relation("AttachmentUploader")

  @@map("users")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Workspace {
  id             String                @id @default(uuid()) @db.Uuid
  name           String                @db.VarChar(100)
  ownerId        String                @map("owner_id") @db.Uuid
  owner          User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members        WorkspaceMember[]
  invitations    WorkspaceInvitation[]
  projects       Project[]
  notifications  Notification[]
  activityEvents ActivityEvent[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  archivedAt     DateTime?             @map("archived_at")

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  email       String        @db.VarChar(320)
  role        WorkspaceRole
  tokenHash   String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  invitedBy   String        @map("invited_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender      User          @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  workspaceId    String          @map("workspace_id") @db.Uuid
  name           String          @db.VarChar(100)
  description    String?         @db.VarChar(2000)
  status         ProjectStatus   @default(ACTIVE)
  createdBy      String          @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  archivedAt     DateTime?       @map("archived_at")
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator        User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  boards         Board[]
  labels         Label[]
  activityEvents ActivityEvent[]

  @@index([workspaceId, status])
  @@map("projects")
}

model Board {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(100)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   Column[]
  tasks     Task[]

  @@index([projectId])
  @@map("boards")
}

model Column {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String   @db.VarChar(100)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([id, boardId])
  @@index([boardId, position])
  @@map("columns")
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  boardId        String          @map("board_id") @db.Uuid
  columnId       String          @map("column_id") @db.Uuid
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  rank           String          @db.VarChar(18)
  priority       TaskPriority    @default(NONE)
  dueAt          DateTime?       @map("due_at")
  createdBy      String          @map("created_by") @db.Uuid
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  completedAt    DateTime?       @map("completed_at")
  archivedAt     DateTime?       @map("archived_at")
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column         Column          @relation(fields: [columnId, boardId], references: [id, boardId], onDelete: Restrict)
  creator        User            @relation("TaskCreator", fields: [createdBy], references: [id])
  assignees      TaskAssignee[]
  labels         TaskLabel[]
  comments       Comment[]
  notifications  Notification[]
  activityEvents ActivityEvent[]
  attachments    Attachment[]

  @@unique([columnId, rank])
  @@index([boardId, archivedAt])
  @@index([columnId, rank])
  @@index([dueAt, id])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  name      String      @db.VarChar(50)
  color     String      @db.VarChar(7)
  createdAt DateTime    @default(now()) @map("created_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model Comment {
  id            String           @id @default(uuid()) @db.Uuid
  taskId        String           @map("task_id") @db.Uuid
  authorId      String           @map("author_id") @db.Uuid
  content       String           @db.VarChar(4000)
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author        User             @relation("CommentAuthor", fields: [authorId], references: [id])
  mentions      CommentMention[]
  notifications Notification[]

  @@index([taskId, createdAt, id])
  @@map("comments")
}

model CommentMention {
  commentId String  @map("comment_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  COMMENT
  ROLE_CHANGED
  DUE_SOON
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  taskId      String?          @map("task_id") @db.Uuid
  commentId   String?          @map("comment_id") @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String?          @map("actor_id") @db.Uuid
  type        NotificationType
  dedupeKey   String?          @unique @map("dedupe_key") @db.VarChar(200)
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([recipientId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

enum AttachmentStatus {
  PENDING
  READY
}

model Attachment {
  id            String           @id @default(uuid()) @db.Uuid
  taskId        String           @map("task_id") @db.Uuid
  uploaderId    String           @map("uploader_id") @db.Uuid
  fileName      String           @map("file_name") @db.VarChar(255)
  contentType   String           @map("content_type") @db.VarChar(100)
  size          Int
  storagePath   String           @unique @map("storage_path") @db.VarChar(255)
  status        AttachmentStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at")
  uploadedAt    DateTime?        @map("uploaded_at")
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader      User             @relation("AttachmentUploader", fields: [uploaderId], references: [id])

  @@index([taskId, status, createdAt])
  @@map("attachments")
}

enum ActivityType {
  WORKSPACE_CREATED
  WORKSPACE_RENAMED
  WORKSPACE_ARCHIVED
  OWNER_TRANSFERRED
  MEMBER_INVITED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  PROJECT_CREATED
  PROJECT_ARCHIVED
  BOARD_CREATED
  BOARD_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_ASSIGNED
  TASK_LABELS_CHANGED
  TASK_ARCHIVED
  TASK_DELETED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
}

model ActivityEvent {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  taskId      String?      @map("task_id") @db.Uuid
  actorId     String       @map("actor_id") @db.Uuid
  entityType  String       @map("entity_type") @db.VarChar(30)
  entityId    String       @map("entity_id") @db.Uuid
  eventType   ActivityType @map("event_type")
  metadata    Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at")
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor       User         @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt, id])
  @@index([taskId, createdAt, id])
  @@map("activity_events")
}
